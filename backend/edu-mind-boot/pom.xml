<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.edumind</groupId>
        <artifactId>edu-mind-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>edu-mind-boot</artifactId>
    <name>edu-mind-boot</name>
    <description>Spring Boot 启动入口与主配置文件</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edumind</groupId>
            <artifactId>edu-mind-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edumind</groupId>
            <artifactId>edu-mind-course</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edumind</groupId>
            <artifactId>edu-mind-question</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edumind</groupId>
            <artifactId>edu-mind-teaching</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edumind</groupId>
            <artifactId>edu-mind-resource</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edumind</groupId>
            <artifactId>edu-mind-knowledge</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edumind</groupId>
            <artifactId>edu-mind-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edumind</groupId>
            <artifactId>edu-mind-notification</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edumind</groupId>
            <artifactId>edu-mind-statistics</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edumind</groupId>
            <artifactId>edu-mind-job</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <skip>false</skip>
                    <mainClass>com.edumind.EduMindApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
